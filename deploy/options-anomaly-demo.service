[Unit]
Description=Options Anomaly Lab public demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/options-anomaly-demo
EnvironmentFile=%h/.config/options-anomaly-demo/runtime.env
ExecStart=%h/options-anomaly-demo/.venv/bin/python -m uvicorn options_demo.app:app --host ${OPTIONS_BIND_HOST} --port 8781 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=65
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=default.target
